# FocalPoint OS environment variables

# Required in production
SECRET_KEY=change-me-to-a-long-random-string

# Database (leave empty / omit for SQLite)
# DATABASE_URL=postgresql://focalpoint:focalpoint@db:5432/focalpoint

# SMTP for emails (verification, password reset, briefs, invites)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=briefs@yourorg.org

# Optional
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
